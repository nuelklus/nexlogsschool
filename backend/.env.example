# Copy to backend/.env on the server and fill in. Never commit the real file.
DJANGO_ENV=production
DJANGO_DEBUG=false
# 50+ random characters: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
# API hostname only; no localhost, 127.0.0.1 or *.
DJANGO_ALLOWED_HOSTS=api.example.com
# Set when Nginx terminates HTTPS, otherwise you get a redirect loop.
DJANGO_SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO

# Frontend origin (HTTPS, no path). Keep it on the same parent domain as the API.
NLSCHOOL_FRONTEND_URL=https://app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com

# PostgreSQL. Production requires TLS verification (verify-full or verify-ca).
DJANGO_DB_NAME=nlschool
DJANGO_DB_USER=nlschool_user
DJANGO_DB_PASSWORD=
# For verify-full this must match the hostname on the database server certificate.
DJANGO_DB_HOST=db.example.com
DJANGO_DB_PORT=5432
DJANGO_DB_SSLMODE=verify-full
DJANGO_DB_SSLROOTCERT=/etc/ssl/nlschool/db-ca.crt

# Uploaded files (supplier documents). Absolute path outside the app directory.
DJANGO_MEDIA_ROOT=/var/lib/nlschool/media

# SMTP is mandatory in production (verification and password-reset emails).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=NLSchool <no-reply@example.com>

# First-time setup of the platform owner; remove or rotate after use.
NLSCHOOL_SETUP_TOKEN=
NLSCHOOL_SUPPORT_EMAIL=
NLSCHOOL_BILLING_INSTRUCTIONS=
